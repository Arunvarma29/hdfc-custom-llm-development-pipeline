# ============================================================
# DATASETS
# ============================================================

# Do not commit raw banking datasets
datasets/raw/
datasets/unrefined/
datasets/private/
datasets/confidential/

# Local prepared datasets / generated data
datasets/prepared/
datasets/processed/
datasets/output/

# Dataset files accidentally placed in project
*.csv
*.xlsx
*.xls
*.parquet
*.jsonl

# Allow explicitly committed sample/test datasets
!datasets/sample/
!datasets/sample/**/*.csv
!datasets/sample/**/*.xlsx
!datasets/sample/**/*.jsonl
!datasets/sample/**/*.parquet


